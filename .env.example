# Копирайте като .env и попълнете. Сървърът чете променливите от средата.
PORT=8080
DATA_DIR=./data
# Публичният адрес на инсталацията (с https). Нужен е за връзките, които получават клиентите.
BASE_URL=https://finbridge.example.bg
# true, ако сървърът стои зад обратен прокси (nginx, Caddy, облачен балансьор)
TRUST_PROXY=true
# false затваря свободната регистрация на нови кантори
ALLOW_SIGNUP=true

# Разчитане на фактури с Claude (без ключ документите се въвеждат ръчно)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Изпращане на напомняния по имейл (без тези настройки текстът се копира ръчно)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Кантора <office@example.bg>

# Автоматични напомняния: през колко дни да се повтарят за фирмите с отметка
REMIND_EVERY_DAYS=3
