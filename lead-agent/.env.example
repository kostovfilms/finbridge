# По избор: ключ за Claude API. Без него класификацията е по ключови думи.
ANTHROPIC_API_KEY=
# По избор: път до Chrome/Chromium, ако Playwright не намира свой браузър.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Порт на таблото (по подразбиране 3000)
# DASHBOARD_PORT=3000
